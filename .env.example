# Copy this file to .env and fill in your own values.
# .env is gitignored; only this placeholder file is committed.

# Snowflake account identifier in <orgname>-<account_name> form
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=<your_snowflake_user>
SNOWFLAKE_PASSWORD=<your_snowflake_password>
SNOWFLAKE_WAREHOUSE=CONCRETE_PIPELINE_WH
SNOWFLAKE_DATABASE=CONCRETE_PIPELINE
SNOWFLAKE_SCHEMA=RAW

# Free registration keys
# BLS:    https://data.bls.gov/registrationEngine/
# Census: https://api.census.gov/data/key_signup.html
BLS_API_KEY=<your_bls_api_key>
CENSUS_API_KEY=<your_census_api_key>
