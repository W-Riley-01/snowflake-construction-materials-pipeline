# Secrets -- never commit real credentials
.env

# Raw pulled data -- not source-controlled, regenerated by scripts/
# data/* rather than data/ so the negation below can take effect:
# git cannot re-include a file whose parent directory is itself excluded.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor/OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db
.~lock.*

# Local working notes -- kept on disk, not published
CLAUDE.md
learning-guardrails.md
docs/session_handoff*
docs/*_additions.md
interview_study_sheet.md
data_engineering_study_sheet.md
*.odt

# Power BI report file embeds the account host -- documented, not published
*.pbix
*.pbit

# Key-pair auth material -- keep outside the repo; ignored here as a backstop
*.p8
*.pem
rsa_key*
